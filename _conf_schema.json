{
  "llm": {
    "description": "LLM 配置",
    "type": "object",
    "items": {
      "provider_id": {
        "description": "用于分析人格的 LLM 提供商",
        "hint": "留空时使用当前正在使用的 LLM 提供商",
        "type": "string",
        "default": "",
        "_special": "select_provider"
      }
    }
  },
  "message": {
    "description": "聊天记录与上下文配置",
    "type": "object",
    "items": {
      "initial_days": {
        "description": "优先查询最近多少天",
        "type": "int",
        "slider": {
          "min": 1,
          "max": 90,
          "step": 1
        },
        "default": 30
      },
      "fallback_days": {
        "description": "首次无记录时扩大查询到最近多少天",
        "type": "int",
        "slider": {
          "min": 30,
          "max": 365,
          "step": 5
        },
        "default": 90
      },
      "history_slice": {
        "description": "备用历史工具 slice 参数",
        "hint": "仅在 get_group_msg_history 不可用、回退到 search_qq_chat_history 时使用。例如 :100 表示取前 100 条，冒号来自 Python 切片语法。",
        "type": "string",
        "default": ":100"
      },
      "max_fetch_rounds": {
        "description": "群历史最大扫描轮数",
        "hint": "每轮调用一次 get_group_msg_history。调大可以扫更多历史，但会更慢。",
        "type": "int",
        "slider": {
          "min": 1,
          "max": 200,
          "step": 1
        },
        "default": 50
      },
      "per_query_count": {
        "description": "每轮拉取群消息条数",
        "type": "int",
        "slider": {
          "min": 20,
          "max": 200,
          "step": 10
        },
        "default": 200
      },
      "initial_analysis_messages": {
        "description": "首次克隆分析消息数",
        "hint": "首次创建人格时用于分析的目标发言条数。建议 200-300，越大越准但更耗 Token。",
        "type": "int",
        "slider": {
          "min": 50,
          "max": 500,
          "step": 10
        },
        "default": 240
      },
      "update_analysis_messages": {
        "description": "增量更新分析消息数",
        "hint": "同名同群同 QQ 人格手动克隆、定期更新时使用。建议 80-150。",
        "type": "int",
        "slider": {
          "min": 20,
          "max": 300,
          "step": 10
        },
        "default": 120
      },
      "max_analysis_messages": {
        "description": "旧版兼容：用于分析的最大消息条数",
        "hint": "保留给旧配置兼容。新逻辑优先使用“首次克隆分析消息数”和“增量更新分析消息数”。",
        "type": "int",
        "slider": {
          "min": 20,
          "max": 500,
          "step": 10
        },
        "default": 80
      },
      "max_message_chars": {
        "description": "单条消息最大字符数",
        "type": "int",
        "slider": {
          "min": 50,
          "max": 500,
          "step": 10
        },
        "default": 180
      },
      "max_prompt_chars": {
        "description": "聊天记录部分最大字符数",
        "hint": "用于控制送入模型的聊天记录总长度，避免超过上下文",
        "type": "int",
        "slider": {
          "min": 2000,
          "max": 50000,
          "step": 1000
        },
        "default": 12000
      }
    }
  },
  "admin_only_inject": {
    "description": "仅管理员可注入设定",
    "type": "bool",
    "hint": "打开后只有管理员克隆时会自动注入设定；关闭后所有人克隆都会自动注入。人格数据始终会保存，重复 ID 直接覆盖。",
    "default": true
  },
  "persona": {
    "description": "人格设定",
    "type": "object",
    "items": {
      "system_prompt_prefix": {
        "description": "人格 System Prompt 前缀",
        "hint": "创建/更新人格时会拼在人格设定最前面。可用于统一约束回复长度、口吻和禁忌。",
        "type": "text",
        "default": "像真人群友一样短句回复，默认只回 1-3 句，尽量 80 字以内。\n别自我介绍，别解释设定，别科普腔。\n不要写作文，不要每轮都生成完整闭合段落，不要先总结再解释再升华。\n人类口语是开放的、有互动的、可以不完整的。\n不要用“简单说”“本质上”“总结一下”“对，这就像……”这类助手式承接。\n能一句话说完就别展开；除非用户明确要求详细、展开、分条、认真分析，否则禁止长篇、禁止 Markdown 分点、禁止总结式小作文。\n直接接话，少铺垫，少闭环，像活人。"
      }
    }
  },
  "auto_update": {
    "description": "定期更新",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用自动更新",
        "type": "bool",
        "hint": "关闭后不会自动检查或更新人格。",
        "default": false
      },
      "check_weekday": {
        "description": "每周几检查",
        "hint": "0 表示每天；1 表示周一；7 表示周日。",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 7,
          "step": 1
        },
        "default": 0
      },
      "check_hour": {
        "description": "几点检查",
        "hint": "0-23，0 表示凌晨 0 点。",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        },
        "default": 0
      },
      "stale_days": {
        "description": "更新频率（天）",
        "hint": "检查人格文件的更新时间，超过这个天数才更新。0 表示不限制天数，到检查时间就更新所有人格。",
        "type": "int",
        "slider": {
          "min": 0,
          "max": 30,
          "step": 1
        },
        "default": 7
      }
    }
  }
}
